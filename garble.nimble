version     = "0.1.0"
author      = "daveey"
description = "Garble: five cogs trade four commodities over a noisy radio for the Softmax Coworld platform. Words drop and swap for near-neighbours, the CONFIRMED terms are what the exchange enforces, and a repeat-back is the only shield — priced in airtime. A policy is just a prompt."
license     = "MIT"

srcDir = "src"

requires "nim >= 2.2.4"
requires "bitworld >= 0.1.0"
requires "mummy >= 0.4.7"
requires "curly >= 1.1.1"
requires "whisky"
